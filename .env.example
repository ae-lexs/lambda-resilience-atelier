# Copy this file to `.env` and fill in your values before running `docker compose`.
# Compose will silently substitute empty strings for missing variables, so do not skip this step.

# AWS account that owns the Lambda Resilience Atelier resources.
AWS_ACCOUNT_ID=123456789067

# AWS region for all deployments. The ADR (docs/adr/0001-architecture-and-decisions.md) pins us-east-1.
AWS_REGION=us-east-1

# AWS CLI profile to use. Must be configured with SSO via `aws configure sso`.
# The Docker `cdk` service mounts ${HOME}/.aws read-only and reads this profile.
AWS_PROFILE=your-sso-profile
